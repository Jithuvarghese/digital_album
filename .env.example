# All variables are optional. Without them the site runs in demo mode
# (data saved in the browser, synced across tabs on the same device).

# Supabase project (enables shared, real-time data across devices)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (newer Supabase name), either works

# Server-only: used by /api/admin for moderation in Supabase mode
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSCODE=

# Public site URL used for QR codes and link previews
NEXT_PUBLIC_SITE_URL=
